{
  "name": "skeletone",
  "version": "0.1.0",
  "description": "CSS-only skeleton loader: turn your real markup into a loading skeleton screen with one attribute. No JavaScript, any framework.",
  "author": "Samuel Okwalinga",
  "license": "MIT",
  "style": "skeletone.css",
  "main": "skeletone.css",
  "exports": {
    ".": "./skeletone.css",
    "./skeletone.css": "./skeletone.css"
  },
  "files": [
    "skeletone.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "skeleton",
    "skeleton-loader",
    "skeleton-screen",
    "loading",
    "placeholder",
    "shimmer",
    "css",
    "ssr"
  ],
  "scripts": {
    "test": "playwright test",
    "pack": "yarn pack --filename skeletone.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  },
  "packageManager": "yarn@1.22.22"
}
